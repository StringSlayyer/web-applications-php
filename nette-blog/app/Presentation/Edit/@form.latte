{* Shared Bootstrap rendering of the post form *}
<div class="card shadow-sm border-0">
	<div class="card-body p-4">
		<form n:name="postForm">
			<div class="alert alert-danger" n:ifcontent>
				<div n:foreach="$form->ownErrors as $error">{$error}</div>
			</div>

			<div class="mb-3">
				<label n:name="title" class="form-label fw-semibold">Titulek</label>
				<input n:name="title" n:class="form-control, form-control-lg, $form[title]->hasErrors() ? is-invalid" placeholder="Zadejte titulek příspěvku">
				<div class="invalid-feedback" n:ifcontent>{inputError title}</div>
			</div>

			<div class="mb-4">
				<label n:name="content" class="form-label fw-semibold">Obsah</label>
				<textarea n:name="content" n:class="form-control, $form[content]->hasErrors() ? is-invalid" rows="12" placeholder="Napište obsah příspěvku…"></textarea>
				<div class="invalid-feedback" n:ifcontent>{inputError content}</div>
			</div>

			<div class="d-flex gap-2">
				<button n:name="send" class="btn btn-primary px-4"><i class="bi bi-send me-1"></i>Uložit a publikovat</button>
				<a n:href="Home:default" class="btn btn-outline-secondary">Zrušit</a>
			</div>
		</form>
	</div>
</div>
