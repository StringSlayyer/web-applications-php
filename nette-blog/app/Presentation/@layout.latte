<!DOCTYPE html>
<html lang="cs">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">

	<title>{ifset title}{include title|stripHtml} | {/ifset}Můj blog</title>

	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

	<style>
		body { background: #f4f6fb; min-height: 100vh; display: flex; flex-direction: column; }
		main { flex: 1; }
		.navbar-brand { font-weight: 700; letter-spacing: .02em; }
		.hero { background: linear-gradient(135deg, #4f46e5, #0ea5e9); color: #fff; border-radius: 1rem; }
		.post-card { border: 0; border-radius: .9rem; transition: transform .15s ease, box-shadow .15s ease; }
		.post-card:hover { transform: translateY(-3px); box-shadow: 0 .75rem 1.5rem rgba(0, 0, 0, .08) !important; }
		.post-card .card-title a { color: inherit; text-decoration: none; }
		.post-card .card-title a:hover { color: var(--bs-primary); }
		.post-content, .comment-content { white-space: pre-line; line-height: 1.7; }
		.comment-avatar { width: 2.5rem; height: 2.5rem; font-weight: 600; }
		.card { border-radius: .9rem; }
	</style>

	{asset? 'main.js'}
</head>

<body>
	<nav class="navbar navbar-expand navbar-dark bg-dark shadow-sm">
		<div class="container">
			<a class="navbar-brand" n:href="Home:default"><i class="bi bi-journal-text me-2"></i>Můj blog</a>
			<div class="navbar-nav ms-auto align-items-center gap-2">
				<a n:href="Home:" n:class="nav-link, $presenter->isLinkCurrent('Home:*') ? active">Články</a>
				{if $user->isLoggedIn()}
					<a class="btn btn-sm btn-primary" n:href="Edit:create"><i class="bi bi-plus-lg me-1"></i>Nový příspěvek</a>
					<span class="navbar-text small d-none d-sm-inline"><i class="bi bi-person-circle me-1"></i>{$user->getId()}</span>
					<a class="btn btn-sm btn-outline-light" n:href="Sign:out"><i class="bi bi-box-arrow-right me-1"></i>Odhlásit</a>
				{else}
					<a class="btn btn-sm btn-outline-light" n:href="Sign:in"><i class="bi bi-box-arrow-in-right me-1"></i>Přihlásit</a>
				{/if}
			</div>
		</div>
	</nav>

	<main class="container py-4">
		<div n:foreach="$flashes as $flash" class="alert alert-{$flash->type === 'error' ? 'danger' : $flash->type} alert-dismissible fade show shadow-sm" role="alert">
			{$flash->message}
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zavřít"></button>
		</div>

		{include content}
	</main>

	<footer class="py-4 mt-4 border-top bg-white">
		<div class="container text-center text-muted small">
			&copy; {date('Y')} Můj blog &middot; postaveno na Nette &amp; Bootstrapu
		</div>
	</footer>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
